# Configuración para publicar la web dentro de otra web ya existente.
# Se usa con: npm run build:externa  →  genera dist-externa/
# (No contiene secretos: todo esto acaba siendo público en la web.)

# Carpeta donde irá la web, con barra al principio y al final.
VITE_BASE=/decretomaricarmen/

# Dirección pública completa (para la vista previa en redes y el aviso de privacidad).
# PENDIENTE: sustituir por la dirección definitiva.
VITE_SITE_URL=https://webdeejemplo.com/decretomaricarmen/

# El contador se lee de la copia de GitHub Pages, que se actualiza cada 10 minutos.
VITE_CONTADOR_URL=https://contadordecretomc.github.io/decreto-mari-carmen/data/contador.json

# Opcionales: correo de contacto y organización que firma la campaña.
# Si se dejan vacíos, se usan los valores por defecto de src/config.ts.
VITE_CONTACTO_EMAIL=
VITE_ORGANIZACION=
